.DS_Store

# Compiled Python embeds the full path of its source, account name included. Never track it.
__pycache__/
*.pyc
*.pyo
/target/
node_modules/
*.log

# Large media stays out of git; the published page keeps the copy
*.mp4

# Plan tools: generated files
tools/plan/wbs.json
tools/plan/wbs_section.md
tools/plan/page.html
tools/plan/shots/
tools/plan/__pycache__/

# Benchmark: local environments and outputs
bench/.venv/
bench/out/
bench/**/__pycache__/
bench/.pytest_cache/
bench/vet-out/
bench/.cache/
bench/.harbor-venv/
.claude/worktrees/
