+                    and not key.startswith(("DOCKER_", "COMPOSE_"))
+                ):
+                    exec_command.extend(["-e", key])
+                    exec_env[key] = value
+                else:
+                    exec_command.extend(["-e", f"{key}={value}"])
 
         if user is not None:
